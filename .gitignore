# Local project instructions (including the existing misspelled filename)
/docs/instruction.md
/docs/instuction.md

# Machine-specific VS Code configuration; portable templates stay versioned.
/.vscode/c_cpp_properties.json
/.vscode/*.local.json

# One-off audit reports and scratch/output directories
/docs/function-usage.md
/docs/function-usage.csv
/.tmp/
/tmp/
/artifacts/
*.log
*.tmp
*.bak

# Visual Studio local settings and caches
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.db-shm
*.VC.db-wal
*.VC.opendb
ipch/

# Build output directories
[Dd]ebug/
[Rr]elease/
[Dd]ebugPublic/
x64/
x86/
Win32/
ARM/
ARM64/

# Keep WinAPI sources visible despite the Win32 build-output rule.
!/src/platform/win32/

# C++ compiler, linker and resource editor output
*.obj
*.pch
*.pdb
*.idb
*.ipdb
*.iobj
*.ilk
*.exe
*.dll
*.lib
*.exp
*.res
*.aps
*.tlog
*.lastbuildstate
*.VC.VC.opendb

# The ready-to-run release is intentionally versioned; other EXEs stay ignored.
!/dist/windows-x64/Projecr1_GK.exe
